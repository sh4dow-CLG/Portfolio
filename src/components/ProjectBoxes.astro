---
// POCZĄTEK: dane — zmień 16, żeby ustawić liczbę boksów.
const boxes = Array.from({ length: 16 }, (_, index) => index + 1);
// KONIEC: dane
---

<!-- POCZĄTEK: sekcja pod zdjęciem -->
<section
  id="Projects"
  aria-label="Projekty"
  class="project-section flex min-h-svh items-center bg-[#141414] py-16"
>
  <!-- POCZĄTEK: okno galerii — pasek jest ukryty, ruchem steruje scroll strony -->
  <div
    role="region"
    aria-label="Przewijana galeria projektów"
    tabindex="0"
    data-project-viewport
    aria-describedby="project-scroll-help"
    class="project-viewport w-full overflow-x-auto focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-indigo-200"
  >
    <p id="project-scroll-help" class="sr-only">
      Przewijaj stronę, aby przesuwać boksy. Po ustawieniu fokusu możesz też używać
      strzałek w lewo i w prawo oraz klawiszy Home i End.
    </p>
    <!-- POCZĄTEK: jeden rząd boksów -->
    <div data-project-track class="mx-auto flex w-max min-w-full justify-center gap-3 px-6 py-4 sm:gap-4 sm:px-12">
      {boxes.map((number) => (
        <div
          data-project-box={number}
          aria-hidden="true"
          class="h-[clamp(20rem,52svh,36rem)] w-[clamp(6rem,10vw,11rem)] shrink-0 border border-white/10 bg-zinc-800"
        ></div>
      ))}
    </div>
    <!-- KONIEC: jeden rząd boksów -->
  </div>
  <!-- KONIEC: obszar przewijany -->
</section>
<!-- KONIEC: sekcja pod zdjęciem -->
